{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "jsconfig.json",
      "README.md",
      "DESIGN.md",
      "**/AGENTS.md",
      "**/.*",
      "**/node_modules/**",
      "**/*.d.ts",
      "shared/firebase-config.example.js",
      "works/_template/**",
      "works/**/start/**",
      "works/**/plans/**"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}

